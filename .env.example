AI_MODE=llm
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434

# Semantic runbook retrieval
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
RUNBOOK_RETRIEVAL=semantic
RUNBOOK_VECTOR_INDEX_PATH=data/vector_index/runbooks.json

# Durable LangGraph checkpoints
CHECKPOINT_DB_PATH=data/checkpoints/incident_commander.sqlite
LANGGRAPH_STRICT_MSGPACK=true

# Stage 4: local observability
LOG_LEVEL=INFO

# Stage 4: optional LangSmith tracing (off by default)
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=agentic-incident-commander
# LANGSMITH_API_KEY=...
# LANGSMITH_WORKSPACE_ID=...

# Optional hosted provider
# AI_PROVIDER=openai
# OPENAI_MODEL=gpt-5-mini
# OPENAI_API_KEY=...

RUN_LLM_TESTS=0
